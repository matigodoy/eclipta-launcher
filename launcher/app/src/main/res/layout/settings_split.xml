<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <!-- Preview -->
    <LinearLayout
        android:id="@+id/previewPanel"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:background="@drawable/glass_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:id="@+id/previewHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/previewLogo"
                android:layout_width="46dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/previewTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:includeFontPadding="false"
                android:textColor="?attr/uiText"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/previewHello"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/uiText"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/previewHome"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_home"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/previewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="?attr/uiText"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/previewSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/uiText2"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/previewCar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/previewRail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/previewGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/uiText2"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Options -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp">

        <include layout="@layout/settings_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:fadingEdgeLength="20dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingRight="8dp"
                android:paddingBottom="24dp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
