<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rings" />
        </FrameLayout>

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:textColor="?attr/a3Text"
            android:textSize="34sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="?attr/a3Text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:textColor="?attr/a3Text2"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/reminderPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:background="@drawable/glass_pill"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:paddingLeft="14dp"
            android:paddingTop="9dp"
            android:paddingRight="14dp"
            android:paddingBottom="9dp"
            android:textColor="?attr/a3Text"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/locationPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pin" />

            <TextView
                android:id="@+id/city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="?attr/a3Text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Rail -->
        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnHome"
                style="@style/RailButton"
                android:background="@drawable/accent_circle"
                android:contentDescription="@string/cd_home"
                android:src="@drawable/ic_home" />

            <ImageButton
                android:id="@+id/slot0"
                style="@style/RailButton"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/cd_carplay"
                android:padding="9dp"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/slot1"
                style="@style/RailButton"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/cd_aa"
                android:padding="9dp"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/slot2"
                style="@style/RailButton"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/cd_radio"
                android:padding="9dp"
                android:scaleType="center"
                android:src="@drawable/ic_radio" />

            <ImageButton
                android:id="@+id/slot3"
                style="@style/RailButton"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/cd_music"
                android:src="@drawable/ic_music" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="10dp" />

            <ImageButton
                android:id="@+id/btnApps"
                style="@style/RailButton"
                android:contentDescription="@string/cd_apps"
                android:src="@drawable/ic_apps" />

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/RailButton"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/cd_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Car card -->
        <LinearLayout
            android:id="@+id/carCard"
            android:layout_width="520dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingTop="18dp"
            android:paddingRight="22dp"
            android:paddingBottom="18dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/carTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:textColor="?attr/a3Text"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/carSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:textColor="?attr/a3Text2"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCustomize"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="right|top"
                    android:background="@drawable/glass_circle"
                    android:contentDescription="@string/cd_customize"
                    android:src="@drawable/ic_edit" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <View
                    android:layout_width="440dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:alpha="0.4"
                    android:background="@drawable/car_glow" />

                <View
                    android:id="@+id/floor"
                    android:layout_width="440dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center"
                    android:background="@drawable/floor_line"
                    android:translationY="98dp" />

                <ImageView
                    android:id="@+id/car"
                    android:layout_width="440dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/speed_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:paddingRight="20dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="?attr/a3Text"
                    android:textSize="60sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/kmh"
                    android:textColor="?attr/a3Text2"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/speed_label" />

                        <TextView
                            style="@style/Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gps" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/speedBar"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:max="200"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_bar" />

                    <TextView
                        android:id="@+id/noGps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:text="@string/no_gps"
                        android:textColor="?attr/a3Text2"
                        android:textSize="11sp"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Right column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Now playing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/glass_panel"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingTop="14dp"
                android:paddingRight="18dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/now_playing" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/art_placeholder">

                        <ImageView
                            android:id="@+id/artNote"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_note_big" />

                        <ImageView
                            android:id="@+id/art"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:text="@string/nothing_playing"
                            android:textColor="?attr/a3Text"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="?attr/a3Text2"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/mediaBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_bar" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/posText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|top"
                        android:textColor="?attr/a3Text2"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/durText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|top"
                        android:textColor="?attr/a3Text2"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnPrev"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/glass_circle"
                            android:contentDescription="@string/cd_prev"
                            android:src="@drawable/ic_prev" />

                        <ImageButton
                            android:id="@+id/btnPlay"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp"
                            android:background="@drawable/accent_circle"
                            android:contentDescription="@string/cd_play"
                            android:src="@drawable/ic_play" />

                        <ImageButton
                            android:id="@+id/btnNext"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/glass_circle"
                            android:contentDescription="@string/cd_next"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Radio -->
            <LinearLayout
                android:id="@+id/radioCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:background="@drawable/glass_panel"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingTop="14dp"
                android:paddingRight="18dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/radioLabel"
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/radio_fm" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/radioFreq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:text="--.-"
                        android:textColor="?attr/a3Text"
                        android:textSize="44sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/radioUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MHz"
                            android:textColor="?attr/a3Text2"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/radioBand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="FM"
                            android:textColor="?attr/a3Accent"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnSeekBack"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/glass_circle"
                        android:contentDescription="@string/cd_prev"
                        android:src="@drawable/ic_seek_back" />

                    <ImageButton
                        android:id="@+id/btnSeekFwd"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginLeft="10dp"
                        android:background="@drawable/glass_circle"
                        android:contentDescription="@string/cd_next"
                        android:src="@drawable/ic_seek_fwd" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
