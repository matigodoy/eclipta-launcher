<?xml version="1.0" encoding="utf-8"?>
<!-- Classic MMI look: menu list on the left, flat metallic panels, condensed type. Same ids as activity_main. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="8dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_rings" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:textColor="?attr/a3Text"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:fontFamily="sans-serif-condensed"
            android:textColor="?attr/a3Text2"
            android:textSize="15sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/reminderPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:fontFamily="sans-serif-condensed"
            android:textColor="?attr/a3Accent"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/locationPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textColor="?attr/a3Text2"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:textColor="?attr/a3Text"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/a3Accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Menu -->
        <LinearLayout
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:background="@drawable/mmi_panel"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnHome"
                style="@style/MmiRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/mmi_row_on"
                android:text="@string/cd_home" />

            <TextView
                android:id="@+id/slot0"
                style="@style/MmiRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/mmi_row" />

            <TextView
                android:id="@+id/slot1"
                style="@style/MmiRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/mmi_row" />

            <TextView
                android:id="@+id/slot2"
                style="@style/MmiRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/mmi_row" />

            <TextView
                android:id="@+id/slot3"
                style="@style/MmiRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/mmi_row" />

            <TextView
                android:id="@+id/btnApps"
                style="@style/MmiRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/mmi_row"
                android:text="@string/cd_apps" />

            <TextView
                android:id="@+id/btnSettings"
                style="@style/MmiRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/mmi_row"
                android:text="@string/cd_settings" />

            <TextView
                android:id="@+id/btnCustomize"
                style="@style/MmiRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/mmi_row"
                android:text="@string/cd_customize" />

        </LinearLayout>

        <!-- Car and speed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:background="@drawable/mmi_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/carTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:textColor="?attr/a3Text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/carSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textColor="?attr/a3Text2"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <View
                    android:id="@+id/floor"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="@drawable/floor_line" />

                <ImageView
                    android:id="@+id/car"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="?attr/a3Text"
                    android:textSize="52sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/kmh"
                    android:textColor="?attr/a3Text2"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ProgressBar
                        android:id="@+id/speedBar"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="200"
                        android:progressDrawable="@drawable/progress_bar" />

                    <TextView
                        android:id="@+id/noGps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/no_gps"
                        android:textColor="?attr/a3Text2"
                        android:textSize="13sp"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Media and radio -->
        <LinearLayout
            android:layout_width="290dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.25"
                android:background="@drawable/mmi_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/MmiLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/now_playing" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/mmi_panel">

                        <ImageView
                            android:id="@+id/artNote"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_music" />

                        <ImageView
                            android:id="@+id/art"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-condensed"
                            android:maxLines="2"
                            android:textColor="?attr/a3Text"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-condensed"
                            android:singleLine="true"
                            android:textColor="?attr/a3Text2"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/mediaBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_bar" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp">

                    <TextView
                        android:id="@+id/posText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|top"
                        android:textColor="?attr/a3Text2"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/durText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|top"
                        android:textColor="?attr/a3Text2"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnPrev"
                            style="@style/MmiButton"
                            android:contentDescription="@string/cd_prev"
                            android:src="@drawable/ic_prev" />

                        <ImageButton
                            android:id="@+id/btnPlay"
                            style="@style/MmiButton"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:contentDescription="@string/cd_play"
                            android:src="@drawable/ic_play" />

                        <ImageButton
                            android:id="@+id/btnNext"
                            style="@style/MmiButton"
                            android:contentDescription="@string/cd_next"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/radioCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@drawable/mmi_panel"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/radioLabel"
                    style="@style/MmiLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/radio_fm" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/radioFreq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:includeFontPadding="false"
                        android:text="--.-"
                        android:textColor="?attr/a3Text"
                        android:textSize="36sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/radioUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MHz"
                            android:textColor="?attr/a3Text2"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/radioBand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FM"
                            android:textColor="?attr/a3Accent"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnSeekBack"
                        style="@style/MmiButton"
                        android:contentDescription="@string/cd_prev"
                        android:src="@drawable/ic_seek_back" />

                    <ImageButton
                        android:id="@+id/btnSeekFwd"
                        style="@style/MmiButton"
                        android:layout_marginLeft="8dp"
                        android:contentDescription="@string/cd_next"
                        android:src="@drawable/ic_seek_fwd" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
