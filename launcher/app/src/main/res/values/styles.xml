<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Launcher" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="uiBg">@color/bg</item>
        <item name="uiAccent">@color/accent</item>
        <item name="uiText">@color/text</item>
        <item name="uiText2">@color/text2</item>
        <item name="uiGlassFill">@color/glass_fill</item>
        <item name="uiGlassStroke">@color/glass_stroke</item>
        <item name="uiGlassHi">@color/glass_hi</item>
        <item name="uiTrack">@color/track</item>
        <item name="uiFloor">@color/floor</item>
        <item name="uiOnAccent">#FFFFFFFF</item>
        <item name="uiDialogBg">#FF1A1C20</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">?attr/uiAccent</item>
        <item name="android:textColor">?attr/uiText</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:alertDialogTheme">@style/Dialog.Launcher</item>
        <item name="android:datePickerDialogTheme">@style/Dialog.Launcher</item>
    </style>

    <style name="Theme.Launcher.Blue">
        <item name="uiAccent">#FF2F6BD9</item>
        <item name="android:colorAccent">#FF2F6BD9</item>
    </style>

    <style name="Theme.Launcher.Gray">
        <item name="uiAccent">#FF8A93A3</item>
        <item name="android:colorAccent">#FF8A93A3</item>
    </style>

    <!-- Instrument cluster at night: pure black and red, nothing bright. -->
    <style name="Theme.Launcher.Night">
        <item name="uiBg">#FF000000</item>
        <item name="uiAccent">#FFB3241C</item>
        <item name="uiText">#FFE8392E</item>
        <item name="uiText2">#FF9A2A22</item>
        <item name="uiGlassFill">#0AFF2A20</item>
        <item name="uiGlassStroke">#26FF2A20</item>
        <item name="uiGlassHi">#26FF2A20</item>
        <item name="uiTrack">#1AFF2A20</item>
        <item name="uiFloor">#2EFF2A20</item>
        <item name="uiOnAccent">#FFFFD9D6</item>
        <item name="uiDialogBg">#FF140505</item>
        <item name="android:colorAccent">#FFB3241C</item>
        <item name="android:textColor">#FFE8392E</item>
        <item name="android:windowBackground">#FF000000</item>
    </style>

    <style name="Theme.Launcher.Splash">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Dialog.Launcher" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">?attr/uiAccent</item>
        <item name="android:colorBackgroundFloating">?attr/uiDialogBg</item>
        <item name="android:textColorPrimary">?attr/uiText</item>
        <item name="android:textColorSecondary">?attr/uiText2</item>
        <item name="android:textColor">?attr/uiText</item>
        <item name="android:datePickerStyle">@style/DatePicker.Launcher</item>
    </style>

    <!-- Spinner: bigger touch rows than the calendar at 600 dp high, and years are one flick away. -->
    <style name="DatePicker.Launcher" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
        <item name="android:spinnersShown">true</item>
    </style>

    <style name="Label">
        <item name="android:textColor">?attr/uiText2</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="MmiRow">
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?attr/uiText</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="MmiLabel">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/uiText2</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="MmiButton">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/mmi_button</item>
    </style>

    <style name="RailButton">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/glass_circle</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>
