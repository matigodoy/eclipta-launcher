<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.A3" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.A3.Splash">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Label">
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="RailButton">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/glass_circle</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>
