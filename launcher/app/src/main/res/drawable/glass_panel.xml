<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1dp" android:left="24dp" android:right="24dp" android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_hi" />
        </shape>
    </item>
</layer-list>
